/*
========================================================================================
    qc-scores-nf: default configuration
========================================================================================
*/

params {
    // Input / output
    input              = null
    outdir             = "results"
    fetch_test_data    = false   // set to true by -profile test: fetch public IDATs instead of --input

    // Same parameters as qc_scores_pipeline.R's CONFIG
    norm_method        = "ssnoob"     // ssnoob|raw|illumina|quantile|funnorm
    detp_threshold     = 0.05
    control_pattern    = "Normal"
    qc_resources_dir   = "${projectDir}/assets/qc_resources"

    // Derived from qc_resources_dir -- you normally don't need to touch these
    filter_dir         = "${params.qc_resources_dir}/filter"
    stable_loci_file   = "${params.qc_resources_dir}/Stable_loci.txt"

    // Container (see docker/Dockerfile) -- override with your own image if
    // you build and publish a fork (docker build -t <YOUR_USER>/dnam-qc-scores-nf:latest docker/)
    container          = "ghcr.io/c-roca/dnam-qc-scores-nf:latest"

    help               = false

    max_cpus           = 4
    max_memory         = '32.GB'
    max_time           = '24.h'
}

profiles {
    docker {
        docker.enabled      = true
        process.container   = params.container
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = params.container
    }

    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'

manifest {
    name            = 'dnam-qc-scores-nf'
    description     = 'DB-Score / BIN-Score / CM-Score (Glaser et al. 2024, doi:10.1093/nargab/lqae181) for DNA methylation IDATs, following the same processing Met4All uses'
    author          = 'Carla Roca'
    homePage        = 'https://github.com/c-roca/dnam-qc-scores-nf'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// Execution reports (timeline, trace, report) -- useful for debugging how
// much memory/CPU each process asks for when run against a real-world batch
// of samples
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}
