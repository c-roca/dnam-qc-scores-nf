/*
========================================================================================
    qc-scores-nf: configuracion por defecto
========================================================================================
*/

params {
    // Entrada / salida
    input              = null
    outdir             = "results"

    // Mismos parametros que el CONFIG de qc_scores_pipeline.R
    norm_method        = "ssnoob"     // ssnoob|raw|illumina|quantile|funnorm
    detp_threshold     = 0.05
    control_pattern    = "Normal"
    qc_resources_dir   = "${projectDir}/assets/qc_resources"

    // Derivados de qc_resources_dir -- normalmente no hace falta tocarlos
    filter_dir         = "${params.qc_resources_dir}/filter"
    stable_loci_file   = "${params.qc_resources_dir}/Stable_loci.txt"

    // Contenedor (ver docker/Dockerfile) -- cambia esto por tu propia imagen
    // una vez la publiques (docker build -t <TU_USUARIO>/dnam-qc-scores-nf:latest docker/)
    container          = "ghcr.io/REEMPLAZA_TU_USUARIO/dnam-qc-scores-nf:latest"

    help               = false

    max_cpus           = 4
    max_memory         = '32.GB'
    max_time           = '24.h'
}

profiles {
    docker {
        docker.enabled      = true
        docker.userEmulation = true
        process.container   = params.container
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = params.container
    }

    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'

manifest {
    name            = 'dnam-qc-scores-nf'
    description     = 'DB-Score / BIN-Score / CM-Score (Glaser et al. 2024, doi:10.1093/nargab/lqae181) para IDATs de metilacion, siguiendo el procesamiento de Met4All'
    author          = 'Carla Roca'
    homePage        = 'https://github.com/REEMPLAZA_TU_USUARIO/dnam-qc-scores-nf'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// Reportes de ejecucion (timeline, trace, report) -- utiles para depurar
// cuanta memoria/CPU pide cada proceso cuando se corre contra las 166
// muestras reales
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}
