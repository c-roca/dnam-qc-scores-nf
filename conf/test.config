/*
    Test profile -- runs the full pipeline against a small, legitimately
    public IDAT set fetched automatically from Bioconductor's own minfi
    test-data packages (minfiData for 450K, minfiDataEPIC for EPIC -- see
    bin/fetch_test_data.R). No private IDATs or --input needed:

      nextflow run . -profile test,docker --outdir test_results

    minfiDataEPIC ships 3 technical replicates of a single cell line (no
    control/case contrast), so BIN_SCORE legitimately comes out empty for
    the EPIC leg of this test -- that's documented pipeline behaviour, not
    a bug. EPIC_V2 has no equivalent small public test package yet, so it
    isn't covered here.

    To test against your OWN samples instead (e.g. to validate EPIC_V2, or
    before a real run), see test_data/README.md and pass
    --fetch_test_data false --input test_data/samplesheet_test.csv.
*/

params {
    fetch_test_data = true
    outdir          = "test_results"

    max_cpus   = 2
    max_memory = '8.GB'
    max_time   = '2.h'
}

process {
    cpus   = 2
    memory = '6.GB'
    time   = '1.h'

    withName: 'READ_RGSET|NORMALIZE|BIN_SCORE|CALC_BETA' {
        memory = '6.GB'
    }
}
