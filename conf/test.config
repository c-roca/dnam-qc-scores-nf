/*
    Perfil de test -- corre el pipeline completo contra un subset pequeno
    (2-4 muestras tuyas, mezcla de caso + "Normal") antes de lanzarlo contra
    el dataset real. Pensado para validar en tu propia maquina Linux antes
    de hacer push.

    Como usarlo:
      1. Copia un par de muestras tuyas (los 4 .idat, Grn+Red x 2 muestras)
         a test_data/idats/, y ajusta test_data/samplesheet_test.csv para
         que apunte a ellas (columnas: sample,array_type,sample_group,
         tissue_type,idat_grn,idat_red -- ver bin/make_nf_samplesheet.R si
         prefieres generarlo desde tu targets CSV de siempre).
      2. nextflow run . -profile test,docker --outdir test_results
*/

params {
    input  = "${projectDir}/test_data/samplesheet_test.csv"
    outdir = "test_results"

    max_cpus   = 2
    max_memory = '8.GB'
    max_time   = '2.h'
}

process {
    cpus   = 2
    memory = '6.GB'
    time   = '1.h'

    withName: 'READ_RGSET|NORMALIZE|BIN_SCORE|CALC_BETA' {
        memory = '6.GB'
    }
}
