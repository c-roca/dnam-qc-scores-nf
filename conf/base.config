/*
    Recursos por defecto. minfi/conumee2 son pesados en RAM con EPIC/EPICv2
    (ver la explicacion de RAM que ya le diste al usuario: ~1.05-1.1M sondas
    por RGChannelSet, varias copias vivas a la vez dentro de cada process).
    Ajusta estos numeros a tu maquina real.
*/

process {
    cpus   = 2
    memory = '8.GB'
    time   = '4.h'

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'READ_RGSET' {
        // Lee IDATs crudos de todas las muestras del array a la vez -- el
        // paso mas pesado en RAM, sobre todo en EPIC/EPICv2 con muchas
        // muestras.
        cpus   = 2
        memory = { 16.GB * task.attempt }
    }
    withName: 'NORMALIZE' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'BIN_SCORE' {
        // CNV.create_anno() + un fit/bin/segment por muestra caso
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = '6.h'
    }
    withName: 'CALC_BETA' {
        memory = { 12.GB * task.attempt }
    }
}
