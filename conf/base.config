/*
    Default resources. minfi/conumee2 are memory-heavy with EPIC/EPICv2
    (~1.05-1.1M probes per RGChannelSet, several copies alive at once inside
    each process). Adjust these numbers to your actual machine.
*/

process {
    cpus   = 2
    memory = '8.GB'
    time   = '4.h'

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'READ_RGSET' {
        // Reads raw IDATs for every sample of the array at once -- the
        // heaviest step in memory, especially on EPIC/EPICv2 with many
        // samples.
        cpus   = 2
        memory = { 16.GB * task.attempt }
    }
    withName: 'NORMALIZE' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'BIN_SCORE' {
        // CNV.create_anno() + one fit/bin/segment per case sample
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = '6.h'
    }
    withName: 'CALC_BETA' {
        memory = { 12.GB * task.attempt }
    }
}
